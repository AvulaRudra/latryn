# Lattice applications: Microsoft 365 (Excel + OneDrive + Outlook).
# Paste into Vercel > Project > Settings > Environment Variables (click the Key box and paste),
# fill in the values, tick Production, save and redeploy. Setup: _source/EXCEL_SETUP.md

# Required: from the Azure app registration
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Required: the Microsoft 365 user whose OneDrive holds the Excel file and who sends the emails
MS_USER=contact@latryn.com

# Optional: these are the defaults
EXCEL_FILE_PATH=Lattice/Lattice applications.xlsx
EXCEL_TABLE=Applications
RESUME_FOLDER=Lattice/Resumes
TEAM_EMAIL=contact@latryn.com
REPLY_TO=contact@latryn.com
SITE_URL=https://latryn.com
TIME_ZONE=Asia/Kolkata
